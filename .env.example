# ==============================================================================
# Axinom Key Service Credentials (SPEKE v2 over CPIX 2.3)
# ==============================================================================
# Obtain Tenant ID, Management Key, and Endpoint from Axinom Portal:
# My Mosaic -> DRM -> Key Service
AXINOM_TENANT_ID="your-tenant-id-uuid"
AXINOM_MANAGEMENT_KEY="your-axinom-key-service-management-key"
# Required tenant-specific SPEKE endpoint (or AXINOM_SPEKE_ENDPOINT)
AXINOM_ENDPOINT="https://<tenant-id>.key-service-management.axprod.net/api/SpekeV2"
# Optional: Set to "true" to have Axinom use the exact key IDs requested in CPIX
# AXINOM_OVERRIDE_KEY_IDS="false"

# ==============================================================================
# Axinom Communication Keys (Entitlement Token / JWT Generation)
# ==============================================================================
# Obtain from Axinom Portal -> My Mosaic -> DRM -> Communication Keys
# AXINOM_COMMUNICATION_KEY_ID="your-communication-key-id-uuid"
# AXINOM_COMMUNICATION_KEY="your-base64-communication-key"

# ==============================================================================
# Axinom License Proxy Endpoints (Mandatory for LicenseProxy & Playback Servers)
# ==============================================================================
# Obtain tenant endpoints from Axinom Portal -> My Mosaic -> DRM -> License Services
AXINOM_WIDEVINE_LICENSE_URL="https://<tenant-id>.drm-widevine-licensing.axprod.net/AcquireLicense"
AXINOM_FAIRPLAY_LICENSE_URL="https://<tenant-id>.drm-fairplay-licensing.axprod.net/AcquireLicense"
AXINOM_PLAYREADY_LICENSE_URL="https://<tenant-id>.drm-playready-licensing.axprod.net/AcquireLicense"
AXINOM_FAIRPLAY_CERT_URL="https://<tenant-id>.drm-fairplay-licensing.axprod.net/v2/Certificate"

# Optional: Local FairPlay Application Certificate file (.cer / .der)
# AXINOM_FAIRPLAY_CERT_PATH="/path/to/fairplay.cer"
