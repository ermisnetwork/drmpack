# Axinom Key Service Credentials (SPEKE v2 over CPIX 2.3)
# Obtain Tenant ID and Management Key from Axinom Portal (under My Mosaic -> DRM -> Key Service)
AXINOM_TENANT_ID="00000000-0000-0000-0000-000000000000"
AXINOM_MANAGEMENT_KEY="your-axinom-key-service-management-key"

# Optional overrides (defaults will be used if omitted)
# AXINOM_ENDPOINT="https://key-server-management.axprod.net/api/SpekeV2"
# AXINOM_OVERRIDE_KEY_IDS="false"
